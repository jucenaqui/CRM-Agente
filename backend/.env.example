# Puerto HTTP del backend
PORT=4000
# Secreto para firmar los JWT (OBLIGATORIO cambiarlo; mínimo 32 caracteres aleatorios)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Expiración del token JWT
JWT_EXPIRES_IN=8h
# Ruta del fichero SQLite (relativa a /backend)
DB_PATH=./data/crm.db
# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Asistente IA (Claude) ---
# Clave de la API de Anthropic (https://console.anthropic.com). Sin ella el asistente responde 503.
ANTHROPIC_API_KEY=
# Modelos que el cliente puede elegir (coma). Vacío = todos:
# claude-opus-5-5, claude-sonnet-5-5, claude-haiku-5-5, claude-fable-5-1
AGENT_MODELS=
# Modelo preseleccionado (por defecto claude-opus-5-5)
AGENT_DEFAULT_MODEL=
# Mensajes al asistente por usuario cada 15 minutos
AGENT_RATE_LIMIT_MAX=60
# Qué clave paga el asistente (ver docs/AI_ASSISTANT.md):
#   (vacío)/default        clave del cliente si la guardó; si no, la tuya
#   provider_only          siempre la tuya (ANTHROPIC_API_KEY)
#   customer_only          solo la del cliente
#   customer_then_provider la del cliente y, si se queda sin saldo, la tuya con tope mensual
AGENT_KEY_POLICY=
# Tope mensual (USD) del respaldo con tu clave cuando falla la del cliente
AGENT_FALLBACK_MONTHLY_CAP_USD=10
# Secreto para cifrar la clave que guarda el cliente (si se omite, se deriva de JWT_SECRET)
SETTINGS_ENCRYPTION_KEY=
