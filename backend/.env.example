# Puerto HTTP del backend
PORT=4000
# Secreto para firmar los JWT (OBLIGATORIO cambiarlo; mínimo 32 caracteres aleatorios)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# Expiración del token JWT
JWT_EXPIRES_IN=8h
# Ruta del fichero SQLite (relativa a /backend)
DB_PATH=./data/crm.db
# Origen permitido para CORS (frontend Vite)
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
